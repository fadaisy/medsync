# MedSync — environment variables.
# NEVER commit real values. Copy to `.env.local` and fill in.
# Production values live in Vercel (App env) and Supabase (Functions secrets).

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle/postgres direct + pooler URLs.
# - DATABASE_URL: pooled (port 6543) for runtime/serverless.
# - DATABASE_DIRECT_URL: direct (port 5432) for Drizzle migrations only.
DATABASE_URL=
DATABASE_DIRECT_URL=

# ─── PHI encryption (Phase 0.7) ────────────────────────────────────────────
# 32-byte AES-256-GCM key, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEDSYNC_PHI_KEY=

# ─── Sentry (Phase 0.8) ────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Africa's Talking SMS (wired in Phase 0, exercised Phase 5+) ───────────
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
