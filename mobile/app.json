{
  "expo": {
    "name": "MedSync",
    "slug": "medsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medsync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.medsync.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#042f2e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.medsync.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#042f2e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MedSync uses your photo on your patient profile.",
          "cameraPermission": "MedSync uses your photo on your patient profile.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0f766e"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MedSync uses your location only to list the nearest hospitals when you ask for emergency help. It stays on your phone unless you choose to share it with a hospital.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#042f2e",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "351f1ae3-6f3a-49c9-8cd2-770726308f64"
      }
    },
    "owner": "justfadhul"
  }
}
