    ],
    "note": "Clears once a ketone result is recorded. 'recorded' on a panel may need adding to evalCond."
   },
   {
    "id": "FLAG-EX-INSULIN-STOPPED",
    "level": "urgent",
    "badge": "Medicine stopped: insulin",
    "reason": "Insulin stopped in a person who depends on it or is unwell: risk of ketoacidosis. Check glucose and ketones now",
    "when": {
     "all": [
      {
