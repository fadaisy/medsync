  "classifiers.add": {
   "acuity_band": {
    "label": "Visual acuity",
    "input": "ex.eyes_ent_neck.visual_acuity",
    "source": "ICO-2017",
    "rules": [
     {
      "result": "worse_than_6_12",
      "when": {
       "any": [
        {
         "item": "ex.eyes_ent_neck.visual_acuity",
         "attribute": "right",
         "any_of": [
          "6_18",
          "6_24",
          "6_36",
          "6_60",
          "cf",
          "hm",
          "pl",
          "npl"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.visual_acuity",
         "attribute": "left",
         "any_of": [
          "6_18",
          "6_24",
          "6_36",
          "6_60",
          "cf",
          "hm",
          "pl",
          "npl"
         ]
        }
       ]
      }
     }
    ],
    "note": "Either eye. ICO refers when acuity is worse than 6/12 whatever the retinal grade; the line is the dossier's REF-DM-EYE-REFER-VA."
   },
   "ketone_band": {
    "label": "Ketones",
    "input": "vs.ketones",
    "source": "ADA-EASD-CRISES-2024",
    "rules": [
     {
      "result": "high",
      "when": {
       "any": [
        {
         "panel": "vs.ketones",
         "field": "blood",
         "gte_ref": "REF-EX-KETONE-DKA"
        },
        {
         "panel": "vs.ketones",
         "field": "urine",
         "any_of": [
          "2plus",
          "3plus"
         ]
        }
       ]
      }
     },
     {
      "result": "moderate",
      "when": {
       "panel": "vs.ketones",
       "field": "blood",
       "gte_ref": "REF-EX-KETONE-RISK"
      }
     },
     {
      "result": "raised",
      "when": {
       "any": [
        {
         "panel": "vs.ketones",
         "field": "blood",
         "gte_ref": "REF-EX-KETONE-RAISED"
        },
        {
         "panel": "vs.ketones",
         "field": "urine",
         "any_of": [
          "trace",
          "1plus"
         ]
        }
       ]
      }
     }
    ],
    "note": "First match wins. The bands are named as findings (high, moderate, raised), not as diagnoses: a fasting or vomiting person without diabetes can have high ketones. Urine strips lag behind blood ketones: a low strip with a ketoacidotic picture is not reassurance. The urine cut (2+) is the dossier's REF-DM-ACU-DKA-UKET."
   },
   "dr_review": {
    "label": "Retinopathy: next step",
    "input": "ex.eyes_ent_neck.fundoscopy",
    "source": "ICO-2017",
    "rules": [
     {
      "result": "refer_within_1_month",
      "when": {
       "any": [
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "dr_grade",
         "any_of": [
          "pdr"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
