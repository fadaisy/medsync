         ]
        }
       ]
      }
     },
     {
      "result": "refer_within_3_months",
      "when": {
       "item": "ex.eyes_ent_neck.fundoscopy",
       "attribute": "dr_grade",
       "any_of": [
        "severe_npdr"
       ]
      }
     },
     {
      "result": "refer_cannot_assess",
      "when": {
       "any": [
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "macula",
         "any_of": [
          "cannot_assess"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "view",
         "any_of": [
          "inadequate"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "seen",
         "any_of": [
          "not_visualised"
         ]
        },
        {
         "classifier": "acuity_band",
         "any_of": [
          "worse_than_6_12"
         ]
        },
        {
         "symptom": "sym.blurred_vision",
         "answer": "yes"
        }
       ]
      }
     },
     {
      "result": "re_examine_3_months",
      "when": {
       "item": "ex.eyes_ent_neck.fundoscopy",
       "attribute": "macula",
       "any_of": [
        "non_centre"
       ]
      }
     },
     {
      "result": "refer_routine",
      "when": {
       "item": "ex.eyes_ent_neck.fundoscopy",
       "attribute": "dr_grade",
       "any_of": [
        "moderate_npdr"
       ]
      }
     },
     {
      "result": "re_examine_by_grade",
      "when": {
       "all": [
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "dr_grade",
         "any_of": [
          "none",
          "mild_npdr"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "view",
         "any_of": [
          "adequate"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.fundoscopy",
         "attribute": "method",
         "any_of": [
          "dilated",
          "photograph"
         ]
        },
        {
         "item": "ex.eyes_ent_neck.visual_acuity",
         "recorded": true
        }
       ]
      }
     },
     {
      "result": "incomplete",
      "when": {
       "item": "ex.eyes_ent_neck.fundoscopy",
       "attribute": "dr_grade",
       "any_of": [
        "none",
        "mild_npdr"
       ]
      }
     }
    ],
    "ref": "REF-EX-DR-RECALL",
    "note": "First match wins, most urgent first. ICO: refer when acuity is worse than 6/12 or there are visual symptoms, whatever the grade, and when the retina cannot be seen. 're_examine_by_grade' needs an adequate dilated or photographic view AND a recorded acuity; without them the result is 'incomplete', never a reassuring interval. Uganda's Eye Care Guidelines 2016 refer everyone with diabetes to a retina clinic: the CSO chooses between that rule and ICO's (D-DM-14). The acuity classifier is new.",
    "reconcile": "sym.blurred_vision id; the 'recorded' atom on an item"
   }
  },
  "flag_rules.add": [
   {
    "id": "FLAG-EX-KETONES-HIGH-DM",
    "level": "urgent",
    "badge": "Ketones {ketones}",
    "reason": "High ketones with diabetes or a raised glucose: possible ketoacidosis. Venous gas or bicarbonate and senior review now, or refer now where there is no gas",
